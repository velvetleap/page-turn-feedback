<?xml version="1.0"?>
<ruleset name="Page Turn Feedback" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>WordPress coding standards (Extra, which includes the security and escaping checks) for the plugin files.</description>

	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Development files are not part of the plugin. -->
	<exclude-pattern>/tests/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>
	<exclude-pattern>/vendor/</exclude-pattern>

	<rule ref="WordPress-Extra"/>

	<config name="minimum_wp_version" value="5.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="velvet-leap-page-turn-feedback"/>
			</property>
		</properties>
	</rule>
</ruleset>
