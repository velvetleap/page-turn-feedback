msgstr "A destra"

#: page-turn-feedback.php:273 page-turn-feedback.php:283 page-turn-feedback.php:642
msgid "Section title"
msgstr "Titolo della sezione"

#: page-turn-feedback.php:275 page-turn-feedback.php:286 page-turn-feedback.php:744
msgid "Author name"
msgstr "Nome di chi ha scritto"

#: page-turn-feedback.php:282
msgid "Band behind the card"
msgstr "Fascia dietro la scheda"

#: page-turn-feedback.php:284
msgid "Card"
msgstr "Scheda"

#: page-turn-feedback.php:287
msgid "Quotation marks, dash and folded corner"
msgstr "Virgolette, trattino e angolo piegato"

#: page-turn-feedback.php:294
msgid "Georgia (serif)"
msgstr "Georgia (con grazie)"

#: page-turn-feedback.php:295
msgid "Palatino (serif, book style)"
msgstr "Palatino (con grazie, da libro)"

#: page-turn-feedback.php:298
msgid "System font"
msgstr "Font di sistema"

#: page-turn-feedback.php:487 page-turn-feedback.php:609
msgid "Feedback settings"
msgstr "Impostazioni feedback"

#: page-turn-feedback.php:488
msgid "Settings"
msgstr "Impostazioni"

#. translators: %d: number of characters typed so far.
#: page-turn-feedback.php:537
#, php-format
msgid "That is %d characters: better to shorten it a little."
msgstr "Ora sono %d caratteri: meglio accorciare un po'."

#. translators: 1: number of characters typed so far, 2: recommended maximum.
#: page-turn-feedback.php:539
#, php-format
msgid "Characters: %1$d / %2$d"
msgstr "Caratteri: %1$d / %2$d"

#. translators: 1: new position of the feedback, 2: total number of feedback.
#: page-turn-feedback.php:543
#, php-format
msgid "Moved to position %1$d of %2$d."
msgstr "Spostato alla posizione %1$d di %2$d."

#: page-turn-feedback.php:544
msgid "Go back to the automatic order? The order you set by hand will be lost."
msgstr "Tornare all'ordine automatico? L'ordine impostato a mano andrà perso."

#. translators: %s: name of a ready-made style, for example "Paper".
#: page-turn-feedback.php:568
#, php-format
msgid "Style “%s” filled in. Check the preview, then press “Save Changes”."
msgstr "Stile “%s” inserito. Controlla l'anteprima, poi premi “Salva le modifiche”."

#: page-turn-feedback.php:569
msgid "Original look filled in. Press “Save Changes” to keep it."
msgstr "Aspetto originale inserito. Premi “Salva le modifiche” per mantenerlo."

#: page-turn-feedback.php:582
msgid "Every 3 seconds"
msgstr "Ogni 3 secondi"

#: page-turn-feedback.php:583
msgid "Every 5 seconds"
msgstr "Ogni 5 secondi"

#: page-turn-feedback.php:584
msgid "Every 10 seconds"
msgstr "Ogni 10 secondi"

#: page-turn-feedback.php:585
msgid "Custom number of seconds"
msgstr "Secondi personalizzati"

#: page-turn-feedback.php:586
msgid "No automatic sliding (by hand only)"
msgstr "Nessuno scorrimento automatico (solo a mano)"

#: page-turn-feedback.php:591
msgid "Fast (0.6 seconds)"
msgstr "Veloce (0,6 secondi)"

#: page-turn-feedback.php:592
msgid "Normal (1.1 seconds) - default"
msgstr "Normale (1,1 secondi) - predefinita"

#: page-turn-feedback.php:593
msgid "Slow (1.8 seconds)"
msgstr "Lenta (1,8 secondi)"

#: page-turn-feedback.php:594
msgid "Very slow (2.6 seconds)"
msgstr "Molto lenta (2,6 secondi)"

#: page-turn-feedback.php:595
msgid "Custom duration"
msgstr "Durata personalizzata"

#: page-turn-feedback.php:599
msgid "Default (theme font)"
msgstr "Predefinito (font del tema)"

#: page-turn-feedback.php:600
msgid "Theme heading font"
msgstr "Font dei titoli del tema"

#: page-turn-feedback.php:601
msgid "Theme body font"
msgstr "Font dei testi del tema"

#: page-turn-feedback.php:606
msgid "Other (type the font name)"
msgstr "Altro (scrivi il nome del font)"

#: page-turn-feedback.php:618
msgid "Ready-made styles"
msgstr "Stili già pronti"

#: page-turn-feedback.php:619
msgid "Pick a style to fill in the colors, fonts and alignment below. Nothing changes on the site until you press “Save Changes”, and you can still adjust every detail."
msgstr "Scegli uno stile per compilare qui sotto colori, font e allineamento. Sul sito non cambia nulla finché non premi “Salva le modifiche”, e puoi ancora ritoccare ogni dettaglio."

#: page-turn-feedback.php:633
msgid "Back to the original look"
msgstr "Torna all'aspetto originale"

#: page-turn-feedback.php:639
msgid "Text and sliding"
msgstr "Testo e scorrimento"

#. translators: %s: default section title.
#: page-turn-feedback.php:650
#, php-format
msgid "Shown in the band above the card, in capital letters. The default text is “%s”; if you leave it empty the title is not shown."
msgstr "Compare nella fascia sopra la scheda, in maiuscolo. Il testo predefinito è “%s”; se lo lasci vuoto il titolo non viene mostrato."

#: page-turn-feedback.php:659
msgid "Automatic sliding"
msgstr "Scorrimento automatico"

#: page-turn-feedback.php:667 page-turn-feedback.php:686
msgid "seconds"
msgstr "secondi"

#: page-turn-feedback.php:670
msgid "How long each feedback stays visible before the page turns by itself (custom: 2 to 120 seconds). For short sentences 3–5 seconds are enough; for long comments 10 or more is better."
msgstr "Tempo per cui ogni feedback resta visibile prima di girare pagina da solo (personalizzati: da 2 a 120 secondi). Per frasi brevi bastano 3–5 secondi; per commenti lunghi conviene 10 o più."

#: page-turn-feedback.php:673
msgid "Visitors can press and hold on the text and drag, or tap the folded corner at the bottom right, to turn the page by hand: while they hold, the sliding stops and it restarts when they let go."
msgstr "Chi visita il sito può tenere premuto sul testo e trascinare, oppure toccare l'angolo piegato in basso a destra, per girare pagina a mano: tenendo premuto lo scorrimento si ferma e riparte quando rilascia."

#: page-turn-feedback.php:678
msgid "Page-turn duration"
msgstr "Durata del giro pagina"

#: page-turn-feedback.php:689
msgid "How long the animation lasts when the page folds and goes from one comment to the next (custom: 0.3 to 5 seconds). The reading time chosen above restarts when the page turn is finished."
msgstr "Quanto dura l'animazione della pagina che si piega e passa da un commento al successivo (personalizzata: da 0,3 a 5 secondi). Il tempo di lettura scelto sopra riparte quando il giro pagina è finito."

#: page-turn-feedback.php:695
msgid "Colors"
msgstr "Colori"

#: page-turn-feedback.php:706
msgid "The “Default” button next to each color restores the original green and white."
msgstr "Il pulsante “Predefinito” accanto a ogni colore riporta il verde e il bianco originali."

#: page-turn-feedback.php:708
msgid "Fonts"
msgstr "Font"

#: page-turn-feedback.php:721
msgid "for example: Poppins"
msgstr "per esempio: Poppins"

#: page-turn-feedback.php:728
msgid "“Default” uses the theme fonts (title and name in the heading font, comment in the body font). With “Other” type the name of a font already loaded by the site: if it is not loaded, visitors will see a fallback font."
msgstr "“Predefinito” usa i font del tema (titoli e nome nel font dei titoli, commento nel font dei testi). Con “Altro” scrivi il nome di un font già caricato dal sito: se non è caricato, chi visita il sito vedrà un font di riserva."

#: page-turn-feedback.php:731
msgid "Alignment"
msgstr "Allineamento"

#: page-turn-feedback.php:752
msgid "The name is aligned inside the same column as the comment (to the right of the quotation mark). For a tidy look it is usually best to give the comment and the name the same alignment."
msgstr "Il nome si allinea dentro la stessa colonna del commento (a destra della virgoletta). Per un effetto ordinato di solito conviene dare lo stesso allineamento a commento e nome."

#. translators: %s: the shortcode.
#: page-turn-feedback.php:765
#, php-format
msgid "The feedback appears automatically at the bottom of the home page. To show it on another page too, add the shortcode %s."
msgstr "I feedback compaiono automaticamente in fondo alla home. Per mostrarli anche in un'altra pagina inserisci lo shortcode %s."

#: page-turn-feedback.php:789
msgid "Preview"
msgstr "Anteprima"

#: page-turn-feedback.php:790
msgid "Preview of the feedback card"
msgstr "Anteprima della scheda dei feedback"

#: page-turn-feedback.php:792
msgid "It updates as you change the settings and the page turns by itself, like on the site."
msgstr "Si aggiorna mentre cambi le impostazioni e la pagina gira da sola, come sul sito."

#: page-turn-feedback.php:793
msgid "Where “Default (theme font)” is chosen the preview uses a plain font: on the site your theme font is used."
msgstr "Dove è scelto “Predefinito (font del tema)” l'anteprima usa un font semplice: sul sito viene usato il font del tema."

#: page-turn-feedback.php:795
msgid "The texts are examples, because there is no published feedback yet."
msgstr "I testi sono di esempio, perché non c'è ancora nessun feedback pubblicato."

#. translators: 1: number of the current feedback, 2: total number of feedback.
#: page-turn-feedback.php:939
#, php-format
msgid "%1$d of %2$d"
msgstr "%1$d di %2$d"

#: page-turn-feedback.php:955
msgid "Previous feedback"
msgstr "Feedback precedente"

#: page-turn-feedback.php:958
msgid "Next feedback"
msgstr "Feedback successivo"

#: includes/ordering.php:40 includes/ordering.php:166
msgid "Order of the feedback"
msgstr "Ordine dei feedback"

#: includes/ordering.php:41
msgid "Order"
msgstr "Ordine"

#: includes/ordering.php:140 includes/tools.php:349 includes/tools.php:459
msgid "You are not allowed to do this."
msgstr "Non hai il permesso di farlo."

#: includes/ordering.php:169
msgid "Order saved. The site now shows the feedback in this order."
msgstr "Ordine salvato. Il sito ora mostra i feedback in questo ordine."

#: includes/ordering.php:171
msgid "Automatic order restored: the newest feedback comes first."
msgstr "Ordine automatico ripristinato: i feedback più recenti vengono per primi."

#: includes/ordering.php:176
msgid "There is no published feedback yet."
msgstr "Non c'è ancora nessun feedback pubblicato."

#: includes/ordering.php:181
msgid "The site shows the feedback from top to bottom. Drag a row (or use the arrows) to change its place, then click “Save order”. Until you save, nothing changes on the site."
msgstr "Il sito mostra i feedback dall'alto verso il basso. Trascina una riga (o usa le frecce) per cambiarne il posto, poi clicca “Salva ordine”. Finché non salvi, sul sito non cambia nulla."

#. translators: %d: number of feedback shown on the site.
#: includes/ordering.php:188
#, php-format
msgid "The site shows the first %d. A new feedback goes to the top until you save the order again."
msgstr "Il sito mostra i primi %d. Un nuovo feedback va in cima finché non salvi di nuovo l'ordine."

#: includes/ordering.php:204
msgid "(no name)"
msgstr "(senza nome)"

#: includes/ordering.php:214
msgid "Not shown on the site"
msgstr "Non mostrato sul sito"

#. translators: %s: name of the person who left the feedback.
#: includes/ordering.php:217
#, php-format
msgid "Move “%s” up"
msgstr "Sposta “%s” in su"

#. translators: %s: name of the person who left the feedback.
#: includes/ordering.php:218
#, php-format
msgid "Move “%s” down"
msgstr "Sposta “%s” in giù"

#: includes/ordering.php:225
msgid "Save order"
msgstr "Salva ordine"

#: includes/ordering.php:226
msgid "Back to automatic order (newest first)"
msgstr "Torna all'ordine automatico (prima i più recenti)"

#: includes/presets.php:26
msgid "Paper"
msgstr "Carta"

#: includes/presets.php:42
msgid "Night"
msgstr "Notte"

#: includes/presets.php:58
msgid "Ocean"
msgstr "Oceano"

#: includes/presets.php:74
msgid "Sunset"
msgstr "Tramonto"

#: includes/presets.php:90
msgid "Minimal"
msgstr "Minimale"

#: includes/presets.php:124 includes/tools.php:338
msgid "Mary Smith"
msgstr "Maria Rossi"

#: includes/presets.php:125
msgid "A wonderful experience from start to finish. I would recommend it to anyone."
msgstr "Un'esperienza bellissima dall'inizio alla fine. La consiglio a chiunque."

#: includes/presets.php:128
msgid "John Brown"
msgstr "Luca Bianchi"

#: includes/presets.php:129
msgid "Careful, kind and always on time. A pleasure to work with."
msgstr "Attento, gentile e sempre puntuale. Un piacere lavorare insieme."

#: includes/tools.php:27 includes/tools.php:28 includes/tools.php:510
msgid "Import and export"
msgstr "Importa ed esporta"

#: includes/tools.php:339
msgid "A wonderful experience from start to finish. I recommend it to everyone."
msgstr "Un'esperienza bellissima dall'inizio alla fine. La consiglio a tutti."

#: includes/tools.php:485
msgid "Choose a CSV file first."
msgstr "Scegli prima un file CSV."

#: includes/tools.php:486
msgid "The file could not be uploaded. Please try again."
msgstr "Non è stato possibile caricare il file. Riprova."

#: includes/tools.php:487
msgid "The file is too big (1 MB at most)."
msgstr "Il file è troppo grande (al massimo 1 MB)."

#: includes/tools.php:488
msgid "The file must be a CSV file (name ending in .csv)."
msgstr "Il file deve essere un CSV (nome che finisce con .csv)."

#: includes/tools.php:489
msgid "The file is empty."
msgstr "Il file è vuoto."

#: includes/tools.php:490
msgid "The first row must contain the column names, and one of them must be “comment”. Download the example file to see how it is written."
msgstr "La prima riga deve contenere i nomi delle colonne e una di queste deve essere “comment”. Scarica il file di esempio per vedere come si scrive."

#: includes/tools.php:491
msgid "The file has too many rows. Split it into smaller files."
msgstr "Il file ha troppe righe. Dividilo in file più piccoli."

#. translators: 1: feedback added, 2: feedback skipped because already on the site, 3: rows skipped because they have no comment.
#: includes/tools.php:521
#, php-format
msgid "Import finished: %1$d added, %2$d skipped because they were already here, %3$d skipped because they had no comment."
msgstr "Importazione terminata: %1$d aggiunti, %2$d saltati perché già presenti, %3$d saltati perché senza commento."

#: includes/tools.php:532
msgid "Export to a CSV file"
msgstr "Esporta in un file CSV"

#: includes/tools.php:533
msgid "Download all your feedback (published and drafts) in a CSV file. You can open it with Excel, Google Sheets or LibreOffice, keep it as a copy, or import it again here or on another site."
msgstr "Scarica tutti i tuoi feedback (pubblicati e bozze) in un file CSV. Puoi aprirlo con Excel, Fogli Google o LibreOffice, tenerlo come copia, oppure importarlo di nuovo qui o su un altro sito."

#: includes/tools.php:538
msgid "Download CSV file"
msgstr "Scarica il file CSV"

#: includes/tools.php:539
msgid "Download an example file"
msgstr "Scarica un file di esempio"

#: includes/tools.php:543
msgid "Import from a CSV file"
msgstr "Importa da un file CSV"

#: includes/tools.php:544
msgid "Add many feedback at once from a CSV file. The first row must contain the column names:"
msgstr "Aggiungi molti feedback in una volta da un file CSV. La prima riga deve contenere i nomi delle colonne:"

#: includes/tools.php:546
msgid "<code>name</code>: who left the feedback"
msgstr "<code>name</code>: chi ha lasciato il feedback"

#: includes/tools.php:547
msgid "<code>comment</code>: the text (required)"
msgstr "<code>comment</code>: il testo (obbligatorio)"

#: includes/tools.php:548
msgid "<code>status</code>: <code>publish</code> to show it on the site, <code>draft</code> to keep it hidden (if the column is missing: publish)"
msgstr "<code>status</code>: <code>publish</code> per mostrarlo sul sito, <code>draft</code> per tenerlo nascosto (se la colonna manca: publish)"

#: includes/tools.php:549
msgid "<code>date</code>: for example <code>2026-03-15</code> (if missing: today)"
msgstr "<code>date</code>: per esempio <code>2026-03-15</code> (se manca: oggi)"

#: includes/tools.php:550
msgid "<code>order</code>: place on the site, 1 comes first (if missing: automatic order)"
msgstr "<code>order</code>: posto sul sito, 1 viene per primo (se manca: ordine automatico)"

#. translators: %d: maximum number of rows in a file.
#: includes/tools.php:557
#, php-format
msgid "Feedback that is already on the site (same name and same comment) is skipped, so importing the same file twice does no harm. Nothing is changed or deleted. At most %d rows and 1 MB per file; semicolons and commas are both fine."
msgstr "I feedback già presenti sul sito (stesso nome e stesso commento) vengono saltati, quindi importare due volte lo stesso file non fa danni. Nulla viene modificato o cancellato. Al massimo %d righe e 1 MB per file; vanno bene sia il punto e virgola sia la virgola."

#: includes/tools.php:567
msgid "CSV file"
msgstr "File CSV"

#: includes/tools.php:569
msgid "Import"
msgstr "Importa"

#: includes/tools.php:573
msgid "Move to another WordPress site (XML)"
msgstr "Spostare su un altro sito WordPress (XML)"

#: includes/tools.php:575
msgid "WordPress can already move content between sites with an XML file. On this site open Tools → Export and choose “Feedback”; on the other site open Tools → Import → WordPress (it asks you to install the free WordPress Importer plugin)."
msgstr "WordPress sa già spostare i contenuti tra siti con un file XML. Su questo sito apri Strumenti → Esporta e scegli “Feedback”; sull'altro sito apri Strumenti → Importa → WordPress (ti chiede di installare il plugin gratuito WordPress Importer)."

#: includes/tools.php:576
msgid "Open Tools → Export"
msgstr "Apri Strumenti → Esporta"
