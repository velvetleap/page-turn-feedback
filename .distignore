# Files and folders that stay OUT of the plugin zip (GitHub release and WordPress.org).
# One top-level name per line, with a leading slash. bin/build.sh reads this file; the release zip it
# builds is also what is uploaded to WordPress.org (bin/deploy-wporg.sh).
/.git
/.github
/.gitignore
/.gitattributes
/.distignore
/.wordpress-org
/design
/bin
/tests
/build
# Translations come from translate.wordpress.org (a requirement of the plugin review); the source files stay in the repository.
/languages
/vendor
/composer.json
/composer.lock
/phpcs.xml.dist
/CLAUDE.md
/README.md
/CHANGELOG.md
/LICENSE
